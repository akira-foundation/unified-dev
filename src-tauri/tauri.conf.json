{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unified Dev",
  "version": "0.2.1",
  "identifier": "com.kid.unified-dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unified Dev",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://unified-dev.nyc3.cdn.digitaloceanspaces.com/releases/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCMDczREEzMEVBQkU4NEMKUldSTTZLc09vejBIaTBlWHRUZDc4MGN5UEtuUVQ2dHJ2dlM5ZFpoVTc5UGdDZ0ZuSTlETGtBd04K"
    }
  }
}
