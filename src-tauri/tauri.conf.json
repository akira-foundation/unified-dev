{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unified Dev",
  "version": "0.5.0",
  "identifier": "com.kid.unified-dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unified Dev",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": [
        {
          "schemes": [
            "akira"
          ]
        }
      ]
    },
    "updater": {
      "endpoints": [
        "https://unified-dev.nyc3.cdn.digitaloceanspaces.com/releases/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxRTFGMzEwNzYzNTZDQzYKUldUR2JEVjJFUFBoOGNTN3BCSTM5YWtCVGc1bCtBTHhJcXk0TGJqbFBEQUlCTDgxUkN6QnlZRy8K"
    }
  }
}
